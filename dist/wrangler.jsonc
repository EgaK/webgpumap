{
  "name": "tinymap",
  "main": "./workers/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./statics/", "binding": "STATICS" },

  "vars": {
    "LOCAL": false,
  },

  "dev": {
    "ip": "0.0.0.0",
    // "port": 80,
    "port": 443,
    "local_protocol": "https",
  },
}
