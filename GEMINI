build.js
// build.js （Worker対応版）
import esbuild from 'esbuild';
import { execFile } from 'child_process';
import fs from 'fs';
import compilerPackage from 'google-closure-compiler';
const ClosureCompiler = compilerPackage.compiler;

const isProd = process.env.NODE_ENV === 'production' || process.argv.includes('--prod');

// child_process を Promise 化して扱いやすくする汎用関数
function runClosure(args) {
  return new Promise((resolve, reject) => {
    execFile(ClosureCompiler.COMPILER_PATH, args, { maxBuffer: 1024 * 1024 * 10 }, (error, stdout, stderr) => {
      if (error) reject(stderr);
      else resolve({ stdout, stderr });
    });
  });
}

async function runBuild() {
  fs.mkdirSync('dist/js', { recursive: true });
  fs.mkdirSync('dist/tmp', { recursive: true });

    if (!isProd) {
    // ==========================================
    // 🛠️ 開発モード (esbuild のみで完結・Worker対応)
    // ==========================================
    console.log('ステップ 1: 開発用 Web Worker の一時ビルド...');

    // 1. 先に Worker をバンドルして一時ファイルに出力
    await esbuild.build({
      entryPoints: ['src/my-worker.ts'],
      bundle: true,
      outfile: 'dist/js/worker.dev.js', // 開発中のデバッグ用に一度出力
      format: 'esm',
      target: 'es2022',
      sourcemap: 'inline', // Worker内もデバッグしやすくするためソースマップをインライン化
      define: { 'DEVELOP': '1' }
    });

    // 2. バンドルされた Worker のコードを読み込む
    const devWorkerCode = fs.readFileSync('dist/js/worker.dev.js', 'utf8');

    console.log('ステップ 2: メインコードのビルドとWorkerのインライン化...');

    // 3. メインコードをビルドし、WORKER_CODE に文字列として注入
    await esbuild.build({
      entryPoints: {
        'base': 'src/base.ts',
        'edit': 'src/edit.ts',
        'admin': 'src/admin.ts'
      },
      bundle: true,
      splitting: true, // 開発中は esbuild のコード分割機能を使用
      format: 'esm',
      outdir: 'dist/js',
      target: 'es2022',
      sourcemap: true,
      define: {
        'DEVELOP': '1',
        // 開発用の Worker コード（文字列）をそのまま注入
        'WORKER_CODE': JSON.stringify(devWorkerCode)
      }
    });

    // 不要になった開発用 Worker の単体ファイルを削除
    fs.rmSync('dist/js/worker.dev.js', { force: true });

    console.log('⚡ 開発用マルチチャンク（Worker内包）ビルドが完了しました！');

  } else {

    // ==========================================
    // 🚀 本番モード（2ステップ・ビルド）
    // ==========================================
    console.log('ステップ 1: Web Worker を先に単体で極限圧縮...');

    // 1-1. WorkerのTSをesbuildでJSにバンドル
    await esbuild.build({
      entryPoints: ['src/my-worker.ts'],
      bundle: true,
      outfile: 'dist/tmp/worker.raw.js',
      format: 'esm',
      target: 'es2022',
      define: { 'DEVELOP': '0' }
    });

    // 1-2. WorkerのJSをClosure Compiler Advancedに通す
    // ★ここでメインコードと同じリネーム規則（同じ型定義・共通ルール）が適用されるようにします
    await runClosure([
      '--compilation_level', 'ADVANCED_OPTIMIZATIONS',
      '--language_in', 'ECMASCRIPT_2022',
      '--language_out', 'ECMASCRIPT_2022',
      '--define', 'DEVELOP=0',
      '--js', 'dist/tmp/worker.raw.js',
      '--js_output_file', 'dist/tmp/worker.min.js'
    ]);

    // 1-3. 圧縮されたWorkerのコード（文字列）を読み込む
    const minifiedWorkerCode = fs.readFileSync('dist/tmp/worker.min.js', 'utf8');

    console.log('ステップ 2: メインコードのコンパイルとWorkerのインライン化...');

    // 2-1. esbuildでメインコードをバンドル
    // この際、esbuildの `define` を使って、コード内の `WORKER_CODE` という定数を
    // 先ほど圧縮したWorkerの「文字列データ」に直接置き換えます。
    const result = await esbuild.build({
      entryPoints: { 'base': 'src/base.ts', 'edit': 'src/edit.ts', 'admin': 'src/admin.ts' },
      bundle: true,
      write: true,
      outdir: 'dist/tmp/main',
      format: 'esm',
      metafile: true,
      target: 'es2022',
      define: {
        'DEVELOP': '0',
        // Workerのソースコードを文字列リテラルとして丸ごと注入
        'WORKER_CODE': JSON.stringify(minifiedWorkerCode)
      }
    });

    // 2-2. メインコードの Closure Compiler 実行（引数自動組み立て）
    const outputs = result.metafile.outputs;
    const chunkArgs = [];
    const jsFiles = [];
    const chunkConfig = { 'base': { parent: null }, 'edit': { parent: 'base' }, 'admin': { parent: 'edit' } };

    Object.keys(chunkConfig).forEach((name) => {
      const config = chunkConfig[name];
      const actualFile = Object.keys(outputs).find(p => p.endsWith(`${name}.js`));
      if (!actualFile) return;
      jsFiles.push('--js', actualFile);
      let chunkStr = `${name}:1`;
      if (config.parent) chunkStr += `:${config.parent}`;
      chunkArgs.push('--chunk', chunkStr);
    });

    // メインのClosure実行引数
    const closureArgs = [
      '--compilation_level', 'ADVANCED_OPTIMIZATIONS',
      '--language_in', 'ECMASCRIPT_2022',
      '--language_out', 'ECMASCRIPT_2022',
      '--define', 'DEVELOP=0',
      ...jsFiles,
      ...chunkArgs,
      '--chunk_output_path_prefix', 'dist/js/'
    ];

    await runClosure(closureArgs);

    // 一時ファイルのクリーンアップ
    fs.rmSync('dist/tmp', { recursive: true, force: true });
    console.log('🎉 Web Workerを内包した本番ビルドが正常に完了しました！');
  }
}

runBuild().catch(err => {
  console.error('❌ ビルド失敗:', err);
  process.exit(1);
});




3. 最低限必要な tsconfig.json の作成

プロジェクトのルート（build.js と同じ階層）に tsconfig.json を作成してください。esbuildだけでビルドする場合は型チェックが行われないため、エディタ側で厳密に型チェックを動作させるための設定です。
