export type CameraState = {
  centerX: number;
  centerY: number;
  zoom: number;
  width: number;
  height: number;
  dpr: number;
  revision: number;
};

export type MainToWorker =
  | {
      type: "init";
      canvas: OffscreenCanvas;
      vertices: ArrayBuffer;
      camera: CameraState;
    }
  | {
      type: "camera";
      camera: CameraState;
    }
  | {
      type: "resize";
      width: number;
      height: number;
      dpr: number;
    };

export type WorkerToMain =
  | { type: "ready" }
  | { type: "error"; message: string };
